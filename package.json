{
  "name": "collab-editor",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=apps/server",
    "dev:client": "npm run dev --workspace=apps/client",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "smoke:websocket": "node scripts/smoke-websocket.mjs",
    "smoke:docx": "node scripts/smoke-docx.mjs"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@tiptap/extension-collaboration-cursor": "^2.26.2",
    "tailwindcss": "^4.3.4"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "leveldown@5.6.0": true
  }
}
